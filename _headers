# Cloudflare Pages _headers
# 文档: https://developers.cloudflare.com/pages/configuration/headers/

/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://sp0.baidu.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/api/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-store

# ── LimitRSS 子站（挂载在 /limitrss/）─────────────────────────────
# 子站是"运行时读 markdown 再渲染"的，所以下面两类 MIME 必须正确，
# 否则 ES 模块会被浏览器拒绝加载，更新日志页面会整页空白。
/limitrss/notes/changelog.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/limitrss/src/changelog/*
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/limitrss/data/changelog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/limitrss/assets/*
  Cache-Control: public, max-age=86400

/limitrss/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/limitrss/script.js
  Cache-Control: public, max-age=0, must-revalidate
